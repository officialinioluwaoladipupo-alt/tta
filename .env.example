# Public site configuration
NEXT_PUBLIC_SITE_URL=
# Application base URL used by Auth0 for stable production redirects
APP_BASE_URL=

# Auth0 authentication and dashboard authorization
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_ADMIN_EMAILS=
# Temporary migration fallback; use exactly "true" only during rollout.
AUTH_ALLOW_EMAIL_FALLBACK=false
# Only needed for private key JWT; normally leave unset.
AUTH0_CLIENT_ASSERTION_SIGNING_KEY=

# Neon database
DATABASE_URL=

# Cloudinary media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube API media feed
YOUTUBE_API_KEY=

# Sentry monitoring; disabled when DSN is empty
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
